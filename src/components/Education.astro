---
import { siteConfig } from "../config";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="site-section">
    <div class="section-inner">
      <div class="section-intro">
        <p class="section-kicker">Academic background</p>
        <h2 class="section-title">Education</h2>
      </div>

      <div class="education-list">
        {siteConfig.education.map((education) => {
          const hasDetails = Boolean(
            education.achievements?.length ||
              education.coursework?.length ||
              education.activities?.length ||
              education.highlights?.length,
          );

          return (
            <article class="education-card">
              <div class="education-heading">
                <div>
                  <h3>{education.school}</h3>
                  <p class="education-degree">{education.degree}</p>
                  {education.gpa && (
                    <p class="education-gpa">GPA: {education.gpa}</p>
                  )}
                </div>
                <p class="education-date">{education.dateRange}</p>
              </div>

              {hasDetails && (
                <details class="education-details">
                  <summary>
                    <span>Coursework, activities &amp; achievements</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
                      <path
                        d="M8 3v10M3 8h10"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                  </summary>
                  <div class="education-detail-content">
                    {education.achievements?.length > 0 && (
                      <ul class="education-achievements">
                        {education.achievements.map((achievement) => (
                          <li>{achievement}</li>
                        ))}
                      </ul>
                    )}

                    {education.coursework?.length > 0 && (
                      <div class="education-detail-group">
                        <h4>Relevant Coursework</h4>
                        <div class="education-detail-grid">
                          {education.coursework.map((group) => (
                            <div>
                              <h5>{group.category}</h5>
                              <ul>
                                {group.courses.map((course) => <li>{course}</li>)}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {education.activities?.length > 0 && (
                      <div class="education-detail-group">
                        <h4>Activities</h4>
                        <div class="education-detail-grid">
                          {education.activities.map((group) => (
                            <div>
                              <h5>{group.category}</h5>
                              <ul>
                                {group.items.map((item) => <li>{item}</li>)}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {education.highlights?.length > 0 && (
                      <div class="education-detail-group">
                        <div class="education-detail-grid">
                          {education.highlights.map((group) => (
                            <div>
                              <h4>{group.category}</h4>
                              <ul>
                                {group.items.map((item) => <li>{item}</li>)}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </details>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
