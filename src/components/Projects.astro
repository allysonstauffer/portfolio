---
import { siteConfig } from "../config";

const projectSections = [
  { title: "Featured Work", projects: siteConfig.featuredProjects },
  { title: "Additional Projects", projects: siteConfig.additionalProjects },
].filter((section) => section.projects.length > 0);
---

{
  projectSections.length > 0 && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">
            Featured Work
          </h2>
          <div
            class="mt-2 h-[5px] w-[75px] rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-sm text-base leading-relaxed text-gray-600 sm:text-lg">
            Data systems, analytics, and software built for real people and real decisions.
          </p>
        </div>

        <div class="lg:col-span-8">
          {projectSections.map((section) => (
            <div class={section.title === "Additional Projects" ? "mt-14" : ""}>
              {section.title === "Additional Projects" && (
                <h3 class="mb-6 text-2xl font-bold text-gray-900 sm:text-3xl">
                  Additional Projects
                </h3>
              )}
              <div class="space-y-6">
                {section.projects.map((project, index) => {
                  const hasProblemStory = "problem" in project;
                  const hasHighlights = "highlights" in project;
                  const hasStatus = "status" in project;
                  const hasOfficialLink = "officialLink" in project;

                  return (
                    <article
                      class="rounded-xl border border-gray-300 bg-gray-50 p-4 shadow-sm transition-all duration-300 hover:border-gray-400 hover:shadow-md sm:rounded-2xl sm:p-6 md:p-7"
                      style={`--accent-color: ${siteConfig.accentColor}`}
                    >
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <h3 class="mt-1 text-xl font-bold text-gray-900 sm:text-2xl">
                            {project.name}
                          </h3>
                          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-gray-500 sm:text-sm">
                            {project.category}
                          </p>
                        </div>
                        {hasStatus && (
                          <span class="rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-semibold text-gray-700">
                            {project.status}
                          </span>
                        )}
                      </div>

                      <p class="mt-4 text-base leading-relaxed text-gray-700 sm:text-lg">
                        {project.summary}
                      </p>

                      {("impact" in project || "focus" in project) && (
                        <p class="mt-3 border-l-2 border-[var(--accent-color)] pl-4 text-sm leading-relaxed text-gray-700 sm:text-base">
                          <span class="font-semibold">
                            {"focus" in project ? "Focus: " : "Impact: "}
                          </span>
                          {"focus" in project ? project.focus : project.impact}
                        </p>
                      )}

                      {hasHighlights && (
                        <ul class="mt-4 flex flex-wrap gap-2">
                          {project.highlights.map((highlight) => (
                            <li class="rounded-md bg-white px-3 py-1.5 text-xs font-medium text-gray-700 ring-1 ring-gray-200 sm:text-sm">
                              {highlight}
                            </li>
                          ))}
                        </ul>
                      )}

                      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                        <details class="w-full border-t border-gray-200 pt-3">
                          <summary class="w-fit cursor-pointer rounded-sm text-sm font-semibold text-gray-800 underline decoration-gray-400 underline-offset-4 transition-colors hover:text-[var(--accent-color)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)]">
                            {hasProblemStory ? "Technical Details" : "Project Details"}
                          </summary>
                          <div class="mt-4 space-y-4 text-sm leading-relaxed text-gray-600 sm:text-base">
                            {hasProblemStory && (
                              <div class="space-y-3">
                                <p>
                                  <span class="font-semibold text-gray-800">Problem: </span>
                                  {project.problem}
                                </p>
                                <p>
                                  <span class="font-semibold text-gray-800">My contribution: </span>
                                  {project.contribution}
                                </p>
                              </div>
                            )}
                            {project.details.length > 0 && (
                              <ul class="space-y-2">
                                {project.details.map((detail) => (
                                  <li class="flex items-start">
                                    <span class="mr-3 mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-400" />
                                    <span>{detail}</span>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </details>
                      </div>

                      {project.skills.length > 0 && (
                        <div class="mt-4 flex flex-wrap gap-1.5">
                          {project.skills.map((skill) => (
                            <span class="rounded-md bg-gray-900 px-2.5 py-1 text-xs font-medium text-white">
                              {skill}
                            </span>
                          ))}
                        </div>
                      )}

                      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                        {"link" in project && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold text-gray-700 underline decoration-gray-400 underline-offset-4 transition-colors hover:text-[var(--accent-color)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)]"
                          >
                            Explore Project
                          </a>
                        )}
                        {hasOfficialLink && (
                          <a
                            href={project.officialLink.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold text-gray-700 underline decoration-gray-400 underline-offset-4 transition-colors hover:text-[var(--accent-color)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-color)]"
                          >
                            {project.officialLink.label}
                          </a>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
