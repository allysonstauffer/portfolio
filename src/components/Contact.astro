---
import { siteConfig } from "../config";

const email = siteConfig.social.email;
const outlookComposeUrl = `https://outlook.office.com/mail/deeplink/compose?to=${encodeURIComponent(email)}`;
---

<section id="contact" class="bg-gray-900 px-8 py-16 text-white sm:px-12 md:px-16 lg:px-24">
  <div class="mx-auto max-w-4xl text-center">
    <h2 class="text-3xl font-bold sm:text-4xl md:text-5xl">
      Let’s connect
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-300 sm:text-lg">
      {siteConfig.internshipSearch}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={outlookComposeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:bg-gray-200"
      >
        Email me
      </a>
    </div>
    <a
      href={outlookComposeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-block text-sm text-gray-300 underline underline-offset-4 transition-colors hover:text-white"
    >
      {email}
    </a>
    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-gray-200 underline underline-offset-4 transition-colors hover:text-white"
      >
        LinkedIn
      </a>
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-gray-200 underline underline-offset-4 transition-colors hover:text-white"
      >
        GitHub
      </a>
    </div>
  </div>
</section>
