---
import { siteConfig } from "../config";

const hasProjects =
  siteConfig.featuredProjects.length > 0 ||
  siteConfig.additionalProjects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<header id="header" class="site-header fixed inset-x-0 top-0 z-50">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="site-brand" href="#hero" aria-label={`${siteConfig.name} home`}>
      <span aria-hidden="true">AS</span>
    </a>
    <ul class="site-nav-links">
      {
        hasProjects && (
          <li>
            <a href="#projects">Featured Work</a>
          </li>
        )
      }
      <li><a href="#about">About</a></li>
      {
        hasExperience && (
          <li>
            <a href="#experience">Experience</a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a href="#education">Education</a>
          </li>
        )
      }
      <li><a href="#contact">Contact</a></li>
    </ul>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Enable dark mode"
      aria-pressed="false"
      class="theme-toggle"
    >
      <svg
        class="theme-icon-sun"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3l1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3l1.42-1.42"></path>
      </svg>
      <svg
        class="theme-icon-moon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
      </svg>
      <span id="theme-toggle-label">Dark mode</span>
    </button>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = themeToggle?.querySelector(".theme-icon-sun");
  const moonIcon = themeToggle?.querySelector(".theme-icon-moon");
  const themeLabel = document.getElementById("theme-toggle-label");

  if (
    !(themeToggle instanceof HTMLButtonElement) ||
    !(sunIcon instanceof SVGElement) ||
    !(moonIcon instanceof SVGElement) ||
    !(themeLabel instanceof HTMLSpanElement)
  ) {
    throw new Error("The theme toggle controls could not be initialized.");
  }

  const updateThemeButton = (isDark: boolean) => {
    themeToggle.setAttribute("aria-pressed", String(isDark));
    themeToggle.setAttribute(
      "aria-label",
      isDark ? "Enable light mode" : "Enable dark mode",
    );
    themeLabel.textContent = isDark ? "Light mode" : "Dark mode";
    sunIcon.classList.toggle("hidden", isDark);
    moonIcon.classList.toggle("hidden", !isDark);
  };

  updateThemeButton(document.documentElement.classList.contains("dark"));

  themeToggle.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    updateThemeButton(isDark);

    try {
      localStorage.setItem("portfolio-theme", isDark ? "dark" : "light");
    } catch (error) {
      console.error("Unable to save the theme preference.", error);
    }
  });
</script>
