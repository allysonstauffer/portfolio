---
import { siteConfig } from "../config";

const projectSections = [
  { title: "Featured Work", projects: siteConfig.featuredProjects },
  { title: "Additional Projects", projects: siteConfig.additionalProjects },
].filter((section) => section.projects.length > 0);
---

{
  projectSections.length > 0 && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">
            Featured Work
          </h2>
          <div
            class="mt-2 h-[5px] w-[75px] rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <p class="mt-6 max-w-sm text-base leading-relaxed text-gray-600 sm:text-lg">
            Data systems, analytics, and software built for real people and real decisions.
          </p>
        </div>

        <div class="lg:col-span-8">
          {projectSections.map((section) => (
            <div class={section.title === "Additional Projects" ? "mt-14" : ""}>
              {section.title === "Additional Projects" && (
                <h3 class="mb-6 text-2xl font-bold text-gray-900 sm:text-3xl">
                  Additional Projects
                </h3>
              )}
              <div class="space-y-8">
                {section.projects.map((project, index) => {
                  const link = "link" in project ? project.link : undefined;
                  const outcome =
                    "outcome" in project ? project.outcome : undefined;
                  const Component = link ? "a" : "article";
                  const linkProps = link
                    ? {
                        href: link,
                        target: "_blank",
                        rel: "noopener noreferrer",
                      }
                    : {};

                  return (
                    <Component
                      {...linkProps}
                      style={`--accent-color: ${siteConfig.accentColor}`}
                      class={`group relative block rounded-xl border border-gray-300 bg-gray-50 p-4 shadow-sm transition-all duration-300 sm:rounded-2xl sm:p-6 md:p-8 ${
                        link
                          ? "hover:-translate-y-1 hover:border-[var(--accent-color)] hover:bg-white hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                          : ""
                      }`}
                    >
                      {link && (
                        <div class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-colors duration-300 group-hover:bg-gray-700 sm:right-6 sm:top-6">
                          <svg
                            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div class={link ? "pr-12 sm:pr-14" : ""}>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <h3 class="mt-1 text-xl font-bold text-gray-900 sm:text-2xl">
                            {project.name}
                          </h3>
                          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-gray-500 sm:text-sm">
                            {project.category}
                          </p>
                        </div>

                        <p class="text-base font-medium leading-relaxed text-gray-700 sm:text-lg">
                          {project.summary}
                        </p>

                        <ul class="space-y-2 text-sm leading-relaxed text-gray-600 sm:text-base">
                          {project.bullets.map((bullet) => (
                            <li class="flex items-start">
                              <span class="mr-3 mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-400" />
                              <span>{bullet}</span>
                            </li>
                          ))}
                        </ul>

                        {outcome && (
                          <p class="border-l-2 border-[var(--accent-color)] pl-4 text-sm leading-relaxed text-gray-700 sm:text-base">
                            <span class="font-semibold">Outcome: </span>
                            {outcome}
                          </p>
                        )}

                        {project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-1 sm:gap-2">
                            {project.skills.map((skill) => (
                              <span class="rounded-md bg-gray-900 px-2.5 py-1 text-xs font-medium text-white sm:rounded-lg sm:px-3 sm:py-1.5 sm:text-sm">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
