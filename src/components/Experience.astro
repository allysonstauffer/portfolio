---
import { siteConfig } from "../config";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="site-section">
    <div class="section-inner">
      <div class="section-intro">
        <p class="section-kicker">Where I’ve contributed</p>
        <h2 class="section-title">Experience</h2>
      </div>

      {siteConfig.resumeUrl && (
        <div class="experience-resume">
          <a href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer" class="experience-resume-link">
            View Résumé <span aria-hidden="true">↗</span>
          </a>
        </div>
      )}

      <ol class="experience-timeline">
        {siteConfig.experience.map((experience) => {
          const [leadBullet, ...additionalBullets] = experience.bullets;

          return (
            <li class="experience-entry">
              <span class="experience-marker" aria-hidden="true" />
              <article class="experience-card">
                <header class="experience-heading">
                  <div>
                    <h3>{experience.title}</h3>
                    <p>{experience.company}{"location" in experience && ` · ${experience.location}`}</p>
                  </div>
                  <time>{experience.dateRange}</time>
                </header>
                {leadBullet && <p class="experience-highlight">{leadBullet}</p>}
                {additionalBullets.length > 0 && (
                  <ul class="experience-more">
                    {additionalBullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
)}
