---
import { siteConfig } from "../config";
import ProjectDetails from "./ProjectDetails.astro";
import ProjectLinks from "./ProjectLinks.astro";

const featuredProjects = siteConfig.featuredProjects;
const compactFeaturedProjects = featuredProjects.slice(2);
const additionalProjects = siteConfig.additionalProjects;
const pipelineSteps = ["Python", "BigQuery SQL", "Dataform", "Looker Studio"];

function metricLabel(metric: string) {
  if (/test|fixture/i.test(metric)) return "Testing";
  if (/download|attendee|follower/i.test(metric)) return "Adoption";
  if (/hourly|production reporting/i.test(metric)) return "Operational outcome";
  if (/entit(?:y|ies)|nodes|edges|zone|classrooms|buildings/i.test(metric)) {
    return "Engineering scale";
  }
  if (/\$|dgx|systems/i.test(metric)) return "Infrastructure scale";
  if (/student engineer|team/i.test(metric)) return "Role";
  return "Technical scope";
}

---

{(featuredProjects.length > 0 || additionalProjects.length > 0) && (
  <section id="projects" class="site-section project-section">
    <div class="section-inner">
      <div class="section-intro">
        <p class="section-kicker">Selected work</p>
        <h2 class="section-title">Featured Work</h2>
        <p class="section-description">
          Data systems, analytics, and software built for real people and real decisions.
        </p>
      </div>

      {featuredProjects.length > 0 && (
        <>
          <div class="showcase-list">
            {featuredProjects.slice(0, 2).map((project, index) => (
              <article class={`project-showcase project-showcase-${index + 1}`}>
                <div class="showcase-topline">
                  <span class="project-index">
                    FEATURED / {String(index + 1).padStart(2, "0")}
                  </span>
                  {"status" in project && (
                    <span class="project-status">{project.status}</span>
                  )}
                </div>

                <div class="showcase-main">
                  <p class="project-category">{project.category}</p>
                  <h3>{project.name}</h3>
                  <p class="project-summary">{project.summary}</p>
                  {("impact" in project || "focus" in project) && (
                    <p class="project-outcome">
                      <span>{"focus" in project ? "Current focus" : "Operational outcome"}</span>
                      {"focus" in project ? project.focus : project.impact}
                    </p>
                  )}
                </div>

                <div class="showcase-aside">
                  {index === 0 && (
                    <figure class="pipeline-figure">
                      <figcaption>Reporting pipeline</figcaption>
                      <ol aria-label="Python to BigQuery SQL to Dataform to Looker Studio">
                        <li>Python</li>
                        <li>BigQuery SQL</li>
                        <li>Dataform</li>
                        <li>Looker Studio</li>
                      </ol>
                    </figure>
                  )}
                  <div class="project-skills">
                    {project.skills
                      .filter((skill) => index !== 0 || !pipelineSteps.includes(skill))
                      .map((skill) => <span>{skill}</span>)}
                  </div>
                  <ProjectLinks project={project} />
                </div>

                {"metrics" in project && (
                  <ul class="metric-strip">
                    {project.metrics.map((metric) => (
                      <li>
                        <strong>{metric.value}</strong>
                        <span>{metric.label}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <ProjectDetails project={project} />
              </article>
            ))}
          </div>

          {compactFeaturedProjects.length > 0 && (
            <div class="compact-project-grid">
              {compactFeaturedProjects.map((project, index) => (
                <article class={`project-compact featured-project-${index + 3}`}>
                  <div class="compact-main">
                    <div class="compact-topline">
                      <span class="project-index">
                        FEATURED / {String(index + 3).padStart(2, "0")}
                      </span>
                      {"status" in project && (
                        <span class="project-status">{project.status}</span>
                      )}
                    </div>
                    <p class="project-category">{project.category}</p>
                    <h3>{project.name}</h3>
                    <p class="project-summary">{project.summary}</p>
                    {("impact" in project || "focus" in project) && (
                      <p class="project-outcome">
                        <span>{"focus" in project ? "Current focus" : "Outcome"}</span>
                        {"focus" in project ? project.focus : project.impact}
                      </p>
                    )}
                  </div>
                  {"metrics" in project && (
                    <ul class="metric-strip">
                      {project.metrics.map((metric) => (
                        <li>
                          <strong>{metric.value}</strong>
                          <span>{metric.label}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="compact-side">
                    <div class="project-skills">
                      {project.skills.map((skill) => <span>{skill}</span>)}
                    </div>
                    <ProjectLinks project={project} />
                  </div>
                  <ProjectDetails project={project} />
                </article>
              ))}
            </div>
          )}
        </>
      )}

      {additionalProjects.length > 0 && (
        <div class="additional-projects">
          <div class="additional-heading">
            <p class="section-kicker">More explorations</p>
            <h3>Additional Projects</h3>
          </div>
          <div class="compact-project-grid additional-grid">
            {additionalProjects.map((project) => (
              <article class="project-compact">
                <p class="project-category">{project.category}</p>
                {"status" in project && (
                  <span class="project-status">{project.status}</span>
                )}
                <h4>{project.name}</h4>
                <p class="project-summary">{project.summary}</p>
                {"highlights" in project && project.highlights.length > 0 && (
                  <ul class="project-metrics compact-metrics">
                    {project.highlights.map((highlight) => (
                      <li>
                        <span>{metricLabel(highlight)}</span>
                        <strong>{highlight}</strong>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="project-skills">
                  {project.skills.map((skill) => <span>{skill}</span>)}
                </div>
                <ProjectLinks project={project} />
                <ProjectDetails project={project} />
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
